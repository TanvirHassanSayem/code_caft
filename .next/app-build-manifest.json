      "static/chunks/app/snippets/[id]/page.js"
    ],
    "/profile/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/profile/page.js"
    ],
    "/pricing/page": [
      "static/chunks/webpack.js",
